{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Camera_Match_Result.schema.json",
  "title": "CatDrama V4.1 Camera Match Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "scene_id",
    "source_plan_revision",
    "resolutions"
  ],
  "properties": {
    "schema_version": {
      "const": "4.1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "pattern": "^Scene\\d{2}$"
    },
    "source_plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "selected_camera",
          "camera_status",
          "camera_reason"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^Shot\\d{2}-\\d{2}$"
          },
          "selected_camera": {
            "type": "string",
            "minLength": 1
          },
          "camera_status": {
            "enum": [
              "MATCH",
              "PARTIAL_MATCH"
            ]
          },
          "camera_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
